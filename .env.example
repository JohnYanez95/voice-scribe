API_PORT=8084
DEVICE=cuda
WHISPER_MODEL=large-v3
# Comma-separated list of models selectable at runtime via settings panel.
# If not set, defaults to WHISPER_MODEL only (single-model mode).
WHISPER_AVAILABLE_MODELS=small,large-v3
MAX_AUDIO_SECONDS=60
MAX_UPLOAD_MB=10
CORS_ORIGINS=http://localhost:5174,http://127.0.0.1:5174,https://tauri.localhost,tauri://localhost
MODEL_CACHE_DIR=/cache
TEMP_DIR=/tmp/voice-scribe
LOG_LEVEL=info
