flowchart TB
    App["App\n(state owner)"]

    subgraph Hooks ["Hooks"]
        useRecorder["useRecorder"]
        useHotkeys["useHotkeys"]
    end

    subgraph Presentational ["Presentational"]
        Recorder["Recorder"]
        Settings["Settings"]
        Transcript["Transcript"]
    end

    subgraph Services ["Services"]
        api["api.ts"]
    end

    App --> useRecorder
    App --> useHotkeys
    App -->|"props"| Recorder
    App --> Settings
    App -->|"text, onChange"| Transcript
    App --> api

    useRecorder -.->|"MediaRecorder API"| mic(["Browser"])
    api -.->|"localhost:8000"| backend(["Backend"])

    style App         fill:#ddeeff,stroke:#5588bb,color:#333
    style useRecorder fill:#ffdddd,stroke:#cc4444,color:#333
    style useHotkeys  fill:#ddeeff,stroke:#5588bb,color:#333
    style Recorder    fill:#ddf5dd,stroke:#448844,color:#333
    style Settings    fill:#ede8ff,stroke:#7755aa,color:#333
    style Transcript  fill:#ddf5dd,stroke:#448844,color:#333
    style api         fill:#fffacc,stroke:#b8900a,color:#333
    style mic         fill:#e0e0e0,stroke:#999999,color:#777
    style backend     fill:#e0e0e0,stroke:#999999,color:#777
