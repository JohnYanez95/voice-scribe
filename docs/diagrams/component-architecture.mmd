flowchart TB
    subgraph Container ["Container (state owner)"]
        App["App"]
    end

    subgraph Presentational ["Presentational (stateless)"]
        Recorder["Recorder"]
        Settings["Settings"]
        Transcript["Transcript"]
    end

    subgraph Hooks ["Hooks (browser APIs)"]
        useRecorder["useRecorder"]
        useHotkeys["useHotkeys"]
    end

    subgraph Services ["Services (side effects)"]
        api["api.ts"]
    end

    App -->|"props"| Recorder
    App --> Settings
    App -->|"text, onChange"| Transcript
    App --> useRecorder
    App --> useHotkeys
    App -->|"fetch"| api

    useRecorder -.->|"MediaRecorder API"| mic(["Browser"])
    api -.->|"localhost:8000"| backend(["Backend"])

