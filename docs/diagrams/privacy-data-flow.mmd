flowchart TD
    subgraph ui ["UI Context (browser or Tauri webview)"]
        mic["Microphone audio"]
        vad["VAD gate<br/>sustained silence discarded<br/>(pre-roll pad + sub-redemption<br/>holds ARE sent — protocol C2.6)"]
        preroll["Pre-roll ring<br/>~0.9 s of recent frames<br/>trimmed continuously"]
        blob["Audio blob<br/>(one-shot paths)"]
        fifo["Unfinalized-utterance PCM FIFO<br/>≤ 8 entries (C10.3)"]
        cdel["Dropped on final /<br/>session end"]
        mic --> vad
        vad --> preroll
        vad --> blob
        vad --> fifo
        fifo --> cdel
        fifo -- "degrade replay only" --> blob
    end

    blob --> http["HTTP POST"]
    blob --> wsIn["WebSocket binary"]
    vad --> frames["PCM frames<br/>(v4 streaming, speech only)"]
    preroll -- "replayed at speech onset" --> frames
    frames --> wsStream["WebSocket /ws/stream"]

    subgraph backend ["Backend (Docker container or bare-host sidecar)"]
        tmp1["Temp file — input"]
        tmp2["Temp file — WAV"]
        txt["Transcript text"]
        del["Deleted"]
        tmp1 --> tmp2
        tmp2 -- inference --> txt
        tmp2 --> del

        ring["In-memory buffer<br/>bounded ≤ 27 s ≈ 1.7 MB<br/>NO temp files, never on disk"]
        stxt["Committed + partial text"]
        rdel["Trimmed at each commit,<br/>freed on close/error"]
        ring -- "paced re-decode" --> stxt
        ring --> rdel
    end

    http --> tmp1
    wsIn --> tmp1
    wsStream --> ring

    txt --> resp["JSON response"]
    txt --> wsOut["WS segments"]
    stxt --> wsLive["WS partial / committed"]
    stxt --> wsFinal["WS final"]

    resp --> area["Editable textarea<br/>(finalized text only)"]
    wsOut --> area
    wsFinal --> area
    wsLive --> live["Read-only live region<br/>never copied, persisted,<br/>or fed to a transform (C4.2)"]
    live --> ldel["Cleared at final /<br/>degrade / error"]

    area -- "browser" --> browserClip["navigator.clipboard<br/>.writeText()"]
    area -- "desktop" --> httpPost["HTTP POST :8001/clipboard"]
    httpPost --> rustClip["Rust (arboard)<br/>system clipboard"]

    wsLive -. "?debug=stream ONLY<br/>(URL param, off by default,<br/>not persisted)" .-> wlog["Wire-log buffer<br/>memory-only, capped 2000,<br/>PCM as counts — never audio"]
    wsFinal -.-> wlog
    wlog -- "user-clicked export only<br/>(contains transcript text)" --> wfile["Local JSON download"]
    wlog --> wclear["Cleared on session open<br/>+ page unload"]

    classDef sensitive fill:#ffdddd,stroke:#cc4444
    classDef ephemeral fill:#fffacc,stroke:#b8900a
    classDef output fill:#ddf5dd,stroke:#448844
    classDef deleted fill:#e0e0e0,stroke:#999999,color:#777777

    class mic,blob,frames,preroll,fifo sensitive
    class vad,http,wsIn,wsStream,tmp1,tmp2,ring,httpPost,wlog ephemeral
    class txt,stxt,resp,wsOut,wsLive,wsFinal,area,live,browserClip,rustClip,wfile output
    class del,rdel,cdel,ldel,wclear deleted
